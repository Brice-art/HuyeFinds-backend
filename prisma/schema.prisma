// ============================================================
// Huye Finds — Prisma schema
// Postgres (Neon), designed for Next.js + TypeScript + Tailwind
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (pgbouncer) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection — required by Prisma Migrate (migrations can't
  // run through Neon's pooler reliably). Neon gives you both URLs
  // on the same project dashboard.
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum Role {
  STUDENT
  OWNER   // manages one or more places — not used yet, but the
          // Place.ownerId FK needs somewhere to point once you
          // build business accounts
  ADMIN
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Student Hub posts move through a moderation lifecycle. `REJECTED` keeps the
// row for audit (unlike a hard delete) and `REMOVED` takes down a previously
// approved post — e.g. after a report. Public endpoints only ever serve
// `APPROVED` posts.
enum HubPostStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

// Trust state of a place listing. Ownership (Place.ownerId) and trust are kept
// separate: a restaurant can be listed without being owned yet (UNVERIFIED),
// become CLAIMED once an owner is approved, VERIFIED when an admin vouches for
// it, or SUSPENDED (hidden from public listings) while a problem is sorted out.
enum PlaceVerificationStatus {
  UNVERIFIED
  CLAIMED
  VERIFIED
  SUSPENDED
}

// Moderation state of a place listing, mirroring the HubPostStatus
// lifecycle: a newly created place is PENDING until an admin approves it,
// REJECTED keeps the row for audit, and a once-approved place that turns
// out to be a problem is suspended via verificationStatus (SUSPENDED).
// Public endpoints only ever serve APPROVED places.
enum PlaceModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportTargetType {
  HUB_POST
  PLACE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ------------------------------------------------------------
// Users
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @default("+250780000000")
  passwordHash String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A user can own places (once business accounts exist)
  ownedPlaces Place[]    @relation("PlaceOwner")
  reviews     Review[]
  favorites   Favorite[]
  hubPosts    HubPost[]
  hubPostLikes    HubPostLike[]
  hubPostSaves    HubPostSave[]
  hubPostComments HubPostComment[]
  placeClaims     PlaceClaim[]
  placeClaimsReviewed PlaceClaim[]   @relation("ReviewHandler")
  placeEditRequests PlaceEditRequest[] @relation("EditRequester")
  placeEditRequestsReviewed PlaceEditRequest[] @relation("EditReviewer")
  reportsMade      Report[]      @relation("ReportReporter")
  reportsHandled   Report[]      @relation("ReportHandler")
  passwordResetTokens PasswordResetToken[]

  @@index([email])
}

// Never store the raw reset token — only a hash of it. The raw token is
// emailed to the user and never touches the database; a leaked DB alone
// is then not enough to reset anyone's password.

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ------------------------------------------------------------
// Categories
// ------------------------------------------------------------
// Deliberately a table, not an enum — you WILL add categories
// (stationery, salons, laundry...) after launch, and an enum
// migration for that is more painful than it needs to be.

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  subcategories Subcategory[]
}

// The leaf level of the taxonomy — Places belong to a Subcategory, not
// directly to a Category. "Food & Drinks" is a Category; "Restaurants",
// "Bars", "Cafes" are Subcategories under it.

model Subcategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  places Place[]

  @@index([categoryId])
}

// ------------------------------------------------------------
// Places
// ------------------------------------------------------------

model Place {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @db.Text

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  ownerId String?
  owner   User?   @relation("PlaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Trust/ownership state — separate from `isActive` (soft delete). Public
  // listings and detail pages exclude SUSPENDED places.
  verificationStatus PlaceVerificationStatus @default(UNVERIFIED)
  // New submissions are PENDING until an admin approves them. Existing
  // places were backfilled to APPROVED by the place_moderation migration
  // so nothing already public disappears.
  moderationStatus PlaceModerationStatus @default(PENDING)

  // Price range in RWF. RWF has no minor currency unit in practice,
  // so plain Int is correct here — do not use Float for money.
  priceMin Int
  priceMax Int

  contactPhone  String
  contactPhone2 String?

  // Free-text landmark description, since there's no map integration yet.
  // lat/lng kept nullable so a future map feature doesn't need a
  // structural migration — just backfill.
  landmark  String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  // Denormalized aggregates — trade write-complexity for cheap reads.
  // Recompute in the same transaction whenever a Review is
  // created/updated/deleted (see note at bottom of file). Never trust
  // these as source of truth for anything requiring accuracy (e.g. a
  // "top rated" leaderboard should recompute from Review directly).
  ratingAvg    Decimal @default(0) @db.Decimal(2, 1)
  reviewCount  Int     @default(0)
  favoriteCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       PlaceImage[]
  menuItems    MenuItem[]
  hours        BusinessHour[]
  reviews      Review[]
  favorites    Favorite[]
  claims       PlaceClaim[]
  editRequests PlaceEditRequest[]

  @@index([subcategoryId])
  @@index([isActive, isFeatured])
  @@index([slug])
}

model PlaceImage {
  id        String  @id @default(cuid())
  placeId   String
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([placeId])
}

model MenuItem {
  id        String  @id @default(cuid())
  placeId   String
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  note      String?
  sortOrder Int     @default(0)

  @@index([placeId])
}

model BusinessHour {
  id        String    @id @default(cuid())
  placeId   String
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  openTime  String?   // "07:00" — stored as string on purpose: these are
  closeTime String?   // display hours, not used in date math anywhere yet.
  isClosed  Boolean   @default(false)

  @@unique([placeId, dayOfWeek])
  @@index([placeId])
}

// ------------------------------------------------------------
// Reviews & Favorites
// ------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // enforce 1–5 at the application layer; Postgres
                      // CHECK constraints aren't modeled by Prisma yet
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per student per place — resubmitting should be an
  // update, not a new row.
  @@unique([placeId, userId])
  @@index([placeId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([placeId])
}

// ------------------------------------------------------------
// Restaurant ownership & verification workflow
// ------------------------------------------------------------

// A request to become the owner of an unowned place. Ownership is only
// granted after an admin approves the claim — a student can never self-assign.
model PlaceClaim {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ReviewStatus @default(PENDING)
  // Optional free-text evidence the claimant wants the admin to see
  // (e.g. "I manage this canteen, ask for Gerald at the counter").
  note      String?  @db.Text
  reviewedById String?
  reviewedBy   User?  @relation("ReviewHandler", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt DateTime @default(now())

  // One open claim per user per place. Rejected/approved claims leave a
  // historical row, so a claimant can re-apply after a rejection — the
  // uniqueness constraint only covers PENDING claims.
  @@unique([placeId, userId, status])
  @@index([status])
  @@index([placeId])
}

// Proposed high-risk changes to a place (name, location, phone, ...).
// Owners can't apply these directly — an admin must review and approve.
// Low-risk fields (menu, prices, description, hours) bypass this entirely.
model PlaceEditRequest {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User   @relation("EditRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  status    ReviewStatus @default(PENDING)
  // The proposed values for the fields that need review (name, slug,
  // subcategoryId, contactPhone, contactPhone2, landmark, lat/lng).
  data      Json
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?  @relation("EditReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([placeId])
}

// ------------------------------------------------------------
// User reports (moderation intake)
// ------------------------------------------------------------

// A logged-in user flags a hub post or a place for review. Admins resolve or
// dismiss reports from the dashboard. Reports never mutate the target on
// their own — the human decision does.
model Report {
  id         String   @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  reporterId String
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String   @db.Text
  details    String?  @db.Text
  status     ReportStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?  @relation("ReportHandler", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
}

// ------------------------------------------------------------
// Housing (scaffolded for the roadmap — not wired to the UI yet)
// ------------------------------------------------------------

model HousingListing {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  priceMonth  Int
  landmark    String
  contactPhone String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images HousingImage[]

  @@index([isActive])
}

enum HubPostType {
  SIDE_HUSTLE
  BUY_SELL
  LOST_FOUND
  EVENT
  ANNOUNCEMENT
}

model HubPost {
  id          String      @id @default(cuid())
  type        HubPostType
  title       String
  description String      @db.Text

  price     Int?
  isUrgent  Boolean @default(false)
  isPinned  Boolean @default(false)
  viewCount Int     @default(0)

  contactPhone String?
  location     String?
  eventDate    DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Moderation lifecycle — public endpoints only serve APPROVED posts.
  status    HubPostStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   HubPostImage[]
  likes    HubPostLike[]
  saves    HubPostSave[]
  comments HubPostComment[]

  @@index([type])
  @@index([authorId])
  @@index([isPinned])
  @@index([status])
}

model HubPostImage {
  id        String  @id @default(cuid())
  hubPostId String
  hubPost   HubPost @relation(fields: [hubPostId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([hubPostId])
}

model HubPostLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubPostId String
  hubPost   HubPost  @relation(fields: [hubPostId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hubPostId])
  @@index([hubPostId])
}

model HubPostSave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubPostId String
  hubPost   HubPost  @relation(fields: [hubPostId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hubPostId])
  @@index([hubPostId])
}

model HubPostComment {
  id        String   @id @default(cuid())
  hubPostId String
  hubPost   HubPost  @relation(fields: [hubPostId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([hubPostId])
}

model HousingImage {
  id        String         @id @default(cuid())
  listingId String
  listing   HousingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int            @default(0)
}
